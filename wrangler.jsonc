{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Vite SPA served by Workers Static Assets. Supabase remains the backend.
  // Auto-deploys from GitHub main via Cloudflare Workers Builds.
  "name": "precision-pop-backend",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
